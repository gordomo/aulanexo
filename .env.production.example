# Puerto de AulaNexo en el servidor. Comprobar que esté libre.
PUERTO_APP=8092
APP_URL=https://aulanexo.example.com
MYSQL_DATABASE=aulanexo
MYSQL_USER=aulanexo
MYSQL_PASSWORD='CAMBIAR_PASSWORD_DB'
MYSQL_ROOT_PASSWORD='CAMBIAR_PASSWORD_ROOT_DB_DISTINTA'

# Se usan únicamente al crear el primer superadministrador.
OWNER_EMAIL=administrador@example.com
OWNER_PASSWORD='CAMBIAR_POR_PASSWORD_UNICA_DE_12_CARACTERES_O_MAS'
OWNER_NAME='Administrador de AulaNexo'

# SMTP: puerto 587 con STARTTLS. Para 465: SMTP_SECURE=true.
SMTP_HOST=teambuilder.com.ar
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=contacto@teambuilder.com.ar
SMTP_PASSWORD='CAMBIAR_PASSWORD_SMTP'
MAIL_FROM='AulaNexo <contacto@teambuilder.com.ar>'

# Alternativa opcional: si MAILER_DSN tiene valor, reemplaza host, puerto y credenciales.
# En una URL, codificar usuario y contraseña con percent-encoding.
# MAILER_DSN='smtp://usuario%40dominio.com:password_codificada@mail.dominio.com:587'
MAILER_DSN=
