<%- include('partials/header') %>
<div class="mx-auto max-w-3xl"><h1 class="text-3xl font-bold tracking-tight"><%= title %></h1><% if(description){ %><p class="mt-3 leading-relaxed text-slate-600"><%= description %></p><% } %><form method="post" class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" <% if(typeof confirm!=='undefined'&&confirm){ %>data-confirm="<%= confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(typeof hiddenValues!=='undefined'){ for(const [name,value] of Object.entries(hiddenValues)){ %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }} %><div class="grid gap-6 sm:grid-cols-2"><% for(const f of fields){ %><div class="<%= f.type==='textarea'?'sm:col-span-2':'' %>"><label for="field-<%= f.name %>" class="mb-2 block text-sm font-semibold"><%= f.label %><%= f.required?' *':'' %></label><% if(f.options){ %><select id="field-<%= f.name %>" name="<%= f.name %>" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-3 focus:border-indigo-600 focus:outline-indigo-600" <%= f.required?'required':'' %>><% if(f.required&&!f.options.some(o=>String(o.value)===String(f.value))){ %><option value="">Seleccionar</option><% } %><% for(const o of f.options){ %><option value="<%= o.value %>" <%= String(f.value)===String(o.value)?'selected':'' %>><%= o.label %></option><% } %></select><% }else if(f.type==='textarea'){ %><textarea id="field-<%= f.name %>" name="<%= f.name %>" rows="5" maxlength="5000" class="w-full rounded-lg border border-slate-300 px-3 py-3 focus:border-indigo-600 focus:outline-indigo-600" <%= f.required?'required':'' %>><%= f.value??'' %></textarea><% }else{ %><input id="field-<%= f.name %>" name="<%= f.name %>" type="<%= f.type??'text' %>" value="<%= f.type==='password'?'':f.value??'' %>" class="w-full rounded-lg border border-slate-300 px-3 py-3 focus:border-indigo-600 focus:outline-indigo-600" <%= f.required?'required':'' %> <% if(f.min!==undefined){ %>min="<%= f.min %>"<% } %> <% if(f.max!==undefined){ %>max="<%= f.max %>"<% } %> <% if(f.step!==undefined){ %>step="<%= f.step %>"<% } %> <% if(f.type==='password'){ %>maxlength="128" autocomplete="<%= title==='Iniciar sesión'?'current-password':'new-password' %>"<% } %>><% } %><% if(f.hint){ %><p class="mt-2 text-sm text-slate-500"><%= f.hint %></p><% } %></div><% } %></div><p class="mt-6 text-sm text-slate-500">* Campos obligatorios</p><div class="mt-5 flex flex-wrap gap-3"><button class="rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700"><%= button %></button><a href="<%= typeof backHref!=='undefined' ? backHref : base || (user?'/institutes':'/login') %>" class="rounded-lg border border-slate-300 px-6 py-3 font-medium">Volver</a></div></form></div>
<%- include('partials/footer') %>
