<%- include('partials/header') %><div class="mx-auto max-w-4xl"><p class="text-sm font-semibold text-indigo-600">GUÍA PARA <%= membership ? roleLabel(membership.role).toUpperCase() : 'SUPERADMINISTRADOR' %></p><h1 class="mt-3 text-3xl font-bold sm:text-4xl"><%= title %></h1><p class="mt-4 text-slate-600">Encontrá cómo realizar las tareas disponibles para tu cuenta en <%= membership ? membership.institute_name : "AulaNexo" %>.</p><nav aria-label="Contenido del manual" class="mt-8 grid gap-3 rounded-2xl border border-slate-200 bg-white p-6 sm:grid-cols-2"><% sections.forEach((s,index)=>{ %><a class="text-sm font-medium text-indigo-700 hover:underline" href="#section-<%= index %>"><%= s.title %></a><% }); %></nav><div class="mt-8 space-y-6"><% sections.forEach((s,index)=>{ %><section id="section-<%= index %>" class="scroll-mt-8 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"><h2 class="text-xl font-semibold"><%= s.title %></h2><ol class="mt-5 list-decimal space-y-3 pl-5 leading-relaxed text-slate-700"><% for(const step of s.steps){ %><li><%= step %></li><% } %></ol><a href="<%= s.link %>" class="mt-6 inline-flex font-medium text-indigo-700 hover:underline">Ir a esta sección →</a></section><% }); %></div></div><%- include('partials/footer') %>
