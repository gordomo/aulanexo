<%- include('partials/header') %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-5"><div><p class="mb-2 text-sm font-semibold uppercase tracking-wider text-indigo-600"><%= membership ? membership.institute_name : 'AulaNexo' %></p><h1 class="text-3xl font-bold tracking-tight sm:text-4xl"><%= title %></h1><% if(typeof description!=='undefined'&&description){ %><p class="mt-3 max-w-3xl break-words leading-relaxed text-slate-600"><%= description %></p><% } %></div><%- include('partials/actions',{actions}) %></div>
<% if(typeof pendingRequests!=='undefined'){ %>
<section class="mb-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 sm:p-6" aria-labelledby="pending-title">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div><h2 id="pending-title" class="text-xl font-semibold">Solicitudes pendientes <span class="ml-2 rounded-full bg-indigo-600 px-3 py-1 text-sm text-white"><%= pendingRequestCount %></span></h2><p class="mt-2 text-sm text-slate-600"><%= pendingRequestCount ? 'Revisá las solicitudes de los institutos que quieren acceder a AulaNexo.' : 'No hay solicitudes pendientes de revisión.' %></p></div>
    <a href="/platform/requests" class="rounded-lg border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-700">Ver todas las solicitudes</a>
  </div>
  <% if(pendingRequests.length){ %><ul class="mt-5 divide-y divide-indigo-100 rounded-xl border border-indigo-100 bg-white"><% for(const request of pendingRequests){ %><li class="flex flex-wrap items-center justify-between gap-4 p-4"><div><h3 class="font-semibold"><%= request.institute_name %></h3><p class="mt-1 text-sm text-slate-600"><%= request.contact_name %> · <%= request.created_at %></p></div><a href="/platform/requests/<%= request.id %>" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Revisar solicitud</a></li><% } %></ul><% } %>
</section>
<h2 class="mb-4 text-xl font-semibold">Institutos</h2>
<% } %>
<% if(typeof search!=='undefined'&&search){ %><form method="get" class="mb-5 flex flex-wrap gap-3"><label class="sr-only" for="search">Buscar</label><input id="search" type="search" name="q" value="<%= query %>" placeholder="Buscar por nombre, DNI o correo" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3"><button class="rounded-lg bg-indigo-600 px-5 py-3 font-medium text-white">Buscar</button></form><% } %>
<% if(!items.length){ %><div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><h2 class="text-lg font-semibold"><%= typeof emptyTitle!=='undefined' ? emptyTitle : 'Todavía no hay registros' %></h2><p class="mt-2 text-slate-600"><%= typeof emptyDescription!=='undefined' ? emptyDescription : 'Los resultados aparecerán aquí cuando haya información disponible.' %></p></div><% }else{ %><div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm" tabindex="0" role="region" aria-label="<%= title %>"><table class="w-full text-left text-sm"><caption class="sr-only"><%= title %></caption><thead class="border-b border-slate-200 bg-slate-100"><tr><% for(const c of columns){ %><th scope="col" class="px-5 py-4 font-semibold"><%= c %></th><% } %></tr></thead><tbody class="divide-y divide-slate-100"><% for(const row of items){ %><tr class="hover:bg-slate-50"><% for(const cell of row){ %><td class="max-w-xl whitespace-pre-wrap break-words px-5 py-4 align-top"><% if(Array.isArray(cell)){ %><%- include('partials/actions',{actions:cell}) %><% }else{ %><%= cell %><% } %></td><% } %></tr><% } %></tbody></table></div><% } %>
<%- include('partials/footer') %>
