<!doctype html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · AulaNexo</title><link rel="stylesheet" href="/assets/app.css"><script src="/assets/app.js" defer></script></head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
<a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4" href="#main">Ir al contenido</a>
<header class="border-b border-slate-200 bg-white print:hidden"><div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6"><a href="<%= user ? (user.superAdmin ? '/platform' : '/institutes') : '/' %>" class="flex items-center gap-3 font-semibold"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white" aria-hidden="true">AN</span><span class="text-xl">AulaNexo</span></a><div class="flex flex-wrap items-center gap-4 text-sm"><% if(user){ %><span class="text-slate-600"><%= user.name %></span><a href="/institutes" class="font-medium text-indigo-700">Mis institutos</a><% if(user.superAdmin){ %><a href="/platform" class="font-medium text-indigo-700">Plataforma</a><a href="/platform/help" class="font-medium text-indigo-700">Ayuda de plataforma</a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="rounded-lg border border-slate-300 px-3 py-2 hover:bg-slate-100">Cerrar sesión</button></form><% }else{ %><a href="/request-institute" class="font-medium text-indigo-700">Solicitar acceso</a><a href="/login" class="font-medium text-indigo-700">Iniciar sesión</a><a href="/forgot" class="text-slate-600">Recuperar contraseña</a><% } %></div></div></header>
<% if(base && membership){ %><nav aria-label="Navegación del instituto" class="border-b border-slate-200 bg-white print:hidden"><div class="mx-auto flex max-w-7xl flex-wrap gap-x-5 gap-y-3 px-4 py-3 text-sm sm:px-6"><a class="font-semibold text-indigo-700" href="<%= base %>"><%= membership.institute_name %></a><a href="<%= base %>/commissions">Cursos</a><a href="<%= base %>/attendance">Asistencias</a><% if(membership.role!=='teacher'){ %><a href="<%= base %>/payments">Pagos</a><% } %><a href="<%= base %>/notifications">Notificaciones</a><% if(membership.role==='admin'){ %><a href="<%= base %>/people/student">Alumnos</a><a href="<%= base %>/people/teacher">Profesores</a><a href="<%= base %>/users">Usuarios</a><a href="<%= base %>/settings">Configuración</a><a href="<%= base %>/subscription">Cobros de AulaNexo</a><% } %><% if(membership.role==='student'){ %><a href="<%= base %>/profile">Mis datos</a><% } %><a href="<%= base %>/help">Ayuda</a></div></nav><% } %>
<main id="main" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
