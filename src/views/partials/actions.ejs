<div class="flex flex-wrap items-center gap-2"><% for(const a of actions){ %><% if(a.href){ %><a class="inline-flex rounded-lg border border-indigo-200 bg-white px-3 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50 focus:outline-2 focus:outline-indigo-600" href="<%= a.href %>"><%= a.label %></a><% }else if(a.action){ %><form method="post" action="<%= a.action %>" <% if(a.confirm){ %>data-confirm="<%= a.confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrf %>"><% for(const [name,value] of Object.entries(a.values||{})){ %><input type="hidden" name="<%= name %>" value="<%= value %>"><% } %><button class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-100"><%= a.label %></button></form><% } %><% } %></div>
