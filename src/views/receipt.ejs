<%- include('partials/header') %><article class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-8 print:border-0"><div class="border-b border-slate-200 pb-6"><p class="font-semibold text-indigo-700"><%= membership.institute_name %></p><h1 class="mt-2 text-3xl font-bold"><%= title %></h1><p class="mt-2 text-slate-500">Recibo interno de pago</p></div><dl class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2"><% for(const [label,value] of [['Alumno',receipt.first_name+' '+receipt.last_name],['DNI',receipt.dni||'Sin completar'],['Concepto',receipt.description],['Fecha',receipt.paid_date],['Método',receipt.method],['Referencia',receipt.reference||'—']]){ %><div><dt class="text-sm text-slate-500"><%= label %></dt><dd class="mt-1 font-medium"><%= value %></dd></div><% } %></dl><div class="mt-8 flex justify-between border-t border-slate-200 pt-6 text-xl font-semibold"><span>Total pagado</span><span><%= money(receipt.cents) %></span></div><button type="button" data-print class="mt-8 rounded-lg bg-indigo-600 px-5 py-3 font-medium text-white print:hidden">Imprimir / guardar como PDF</button><p class="mt-6 text-sm text-slate-500">Este recibo no constituye una factura fiscal.</p></article><%- include('partials/footer') %>
